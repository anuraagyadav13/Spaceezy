# Browser-visible API base URL — inlined into the JS bundle at `next build`.
# Development (backend running on the host):
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Production build value:
# NEXT_PUBLIC_API_URL=https://spaceezy.com/api/v1

# Server-side API base URL for SSR/ISR fetches (runtime env, never inlined,
# never sent to the browser). In Docker use the container-internal address so
# server rendering never hairpins through the public internet:
# API_URL=http://express:8000/api/v1
# Leave unset locally — server pages fall back to NEXT_PUBLIC_API_URL.

# Not read by application code (kept for reference only):
# NEXT_PUBLIC_APP_URL=http://localhost:3000
