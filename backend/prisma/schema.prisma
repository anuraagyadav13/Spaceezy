generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrgStatus {
  ACTIVE
  INACTIVE
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users      User[]
  leads      Lead[]
  activities LeadActivity[]
  projects   Project[]
  properties Property[]
  customers  Customer[]
  bookings   Booking[]
  siteVisits SiteVisit[]
  tasks      Task[]
  calls      Call[]
  quotations Quotation[]
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  SALES_EXECUTIVE
  CHANNEL_PARTNER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  email        String
  phone        String?
  passwordHash String
  role         UserRole   @default(SALES_EXECUTIVE)
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions           Session[]
  assignedLeads      Lead[]         @relation("AssignedLeads")
  createdLeads       Lead[]         @relation("CreatedLeads")
  leadActivities     LeadActivity[]
  assignedCustomers  Customer[]     @relation("AssignedCustomers")
  assignedBookings   Booking[]      @relation("AssignedBookings")
  assignedSiteVisits SiteVisit[]    @relation("AssignedSiteVisits")
  assignedTasks      Task[]         @relation("AssignedTasks")
  calls              Call[]         @relation("UserCalls")
  createdQuotations  Quotation[]    @relation("CreatedQuotations")

  @@unique([organizationId, email])
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  QUALIFIED
  SITE_VISIT
  NEGOTIATION
  BOOKED
  CLOSED
  LOST
}

model Lead {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name  String
  phone String
  email String?

  source      String?
  campaign    String?
  landingPage String?

  status LeadStatus @default(NEW)

  assignedToId String?
  assignedTo   User?   @relation("AssignedLeads", fields: [assignedToId], references: [id])

  interestedUnitType String?

  preferredVisitDate DateTime? // Stored in UTC
  preferredVisitTime String?

  message        String?
  nextFollowUpAt DateTime? // Stored in UTC

  createdById String?
  createdBy   User?   @relation("CreatedLeads", fields: [createdById], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities LeadActivity[]
  siteVisits SiteVisit[]
  tasks      Task[]
  calls      Call[]
  quotations Quotation[]
  interests  LeadInterest[]

  @@index([organizationId])
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  STATUS_CHANGE
  ASSIGNMENT
  FOLLOW_UP
  SITE_VISIT
}

model LeadActivity {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type        ActivityType
  description String

  performedById String?
  performedBy   User?   @relation(fields: [performedById], references: [id])

  metadata Json?

  createdAt DateTime @default(now())

  @@index([organizationId])
}

enum ProjectStatus {
  UPCOMING
  PRE_LAUNCH
  UNDER_CONSTRUCTION
  READY_TO_MOVE
  AVAILABLE
  COMPLETED
  FULLY_OCCUPIED
  RENOVATING
  ON_HOLD
  SOLD_OUT
  INACTIVE
}

model Project {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name             String
  projectType      String        @default("Residential") // Residential, Commercial, Mixed_Use
  status           ProjectStatus @default(AVAILABLE)
  developer        String?
  description      String?
  shortDescription String?

  // Location
  address   String
  locality  String?
  city      String?
  state     String?
  pincode   String?
  latitude  Float?
  longitude Float?
  mapUrl    String?
  landmark  String?

  // Overview
  totalLandArea          Float?
  landAreaUnit           String?
  totalTowers            Int?
  totalFloors            Int?
  totalUnits             Int?
  availableUnits         Int?
  launchDate             DateTime?
  expectedCompletionDate DateTime?
  possessionDate         DateTime?

  // RERA
  reraRegistered Boolean @default(false)
  reraNumber     String?
  reraAuthority  String?

  // Pricing
  startingPrice      Decimal? @db.Decimal(12, 2)
  maximumPrice       Decimal? @db.Decimal(12, 2)
  pricePerSqFt       Decimal? @db.Decimal(12, 2)
  priceUnit          String?
  maintenanceCharges Decimal? @db.Decimal(12, 2)
  plcCharges         Decimal? @db.Decimal(12, 2)
  parkingCharges     Decimal? @db.Decimal(12, 2)
  clubCharges        Decimal? @db.Decimal(12, 2)
  otherCharges       Decimal? @db.Decimal(12, 2)

  // Amenities & Assets
  amenities    String[]
  images       String[]
  documents    Json? // e.g. [{name: "Brochure", url: "..."}]
  connectivity Json? // e.g. [{name: "Airport", category: "Transport", distance: "5km", time: "10m"}]

  properties Property[]
  leads      Lead[]
  bookings   Booking[]
  quotations Quotation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

enum PropertyStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model Property {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title         String
  purpose       String? // Sale, Resale, Rent
  type          String? // Residential, Commercial, Plot
  unitNumber    String?
  configuration String? // e.g. "3 BHK"
  bhk           Int?
  area          Int? // Legacy/fallback sq.ft
  areaCarpet    Int? // sq.ft
  areaSaleable  Int? // sq.ft
  areaBuiltUp   Int? // sq.ft
  areaProject   Int? // sq.ft
  areaCovered   Int? // sq.ft
  areaTerrace   Int? // sq.ft
  floor         Int?
  facing        String?
  price         Decimal        @db.Decimal(12, 2)
  status        PropertyStatus @default(AVAILABLE)
  version       Int            @default(0) // Optimistic locking
  featured      Boolean        @default(false)
  images        String[]
  amenities     String[]

  leads        Lead[]
  bookings     Booking[]
  interestedBy LeadInterest[]
  quotations   Quotation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, projectId])
}

enum CustomerStatus {
  ACTIVE
  CLOSED
  INACTIVE
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name   String
  phone  String
  email  String?
  status CustomerStatus @default(ACTIVE)
  notes  String?

  assignedToId String?
  assignedTo   User?   @relation("AssignedCustomers", fields: [assignedToId], references: [id])

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

enum BookingPaymentStatus {
  PENDING
  PARTIAL
  COMPLETED
  CANCELLED
}

model Booking {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  amount        Decimal              @db.Decimal(12, 2)
  bookingDate   DateTime             @default(now()) // Stored in UTC
  paymentStatus BookingPaymentStatus @default(PENDING)

  assignedToId String?
  assignedTo   User?   @relation("AssignedBookings", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

enum SiteVisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model SiteVisit {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // Snapshot/Fallback fields for historical records or unlinked visits
  leadName     String?
  phone        String?
  propertyName String?

  date   DateTime // Stored in UTC
  time   String // Time string like "11:30 AM" or stored as part of date
  status SiteVisitStatus @default(SCHEDULED)

  assignedToId String?
  assignedTo   User?   @relation("AssignedSiteVisits", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

enum TaskType {
  FOLLOW_UP
  MEETING
  CALL
  SITE_VISIT
  OTHER
}

enum TaskStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Task {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title       String
  description String?
  type        TaskType   @default(FOLLOW_UP)
  status      TaskStatus @default(PENDING)
  dueDate     DateTime // Stored in UTC

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  assignedToId String
  assignedTo   User   @relation("AssignedTasks", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  INITIATED
  RINGING
  IN_PROGRESS
  COMPLETED
  MISSED
  FAILED
}

model Call {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  direction CallDirection
  status    CallStatus    @default(INITIATED)

  fromNumber String
  toNumber   String

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation("UserCalls", fields: [userId], references: [id], onDelete: SetNull)

  duration     Int? // in seconds
  recordingUrl String?

  vendorCallId String? // ID from the telephony provider

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events CallEvent[]

  @@index([organizationId])
  @@index([vendorCallId])
}

model CallEvent {
  id     String @id @default(uuid())
  callId String
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  status    CallStatus
  timestamp DateTime   @default(now())

  metadata Json?
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quotation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  totalAmount Decimal         @db.Decimal(12, 2)
  validUntil  DateTime
  status      QuotationStatus @default(DRAFT)

  notes String?

  createdById String
  createdBy   User   @relation("CreatedQuotations", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model LeadInterest {
  id     String @id @default(uuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([leadId, propertyId])
}
