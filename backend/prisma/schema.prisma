generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrgStatus {
  ACTIVE
  INACTIVE
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users      User[]
  leads      Lead[]
  activities LeadActivity[]
  projects   Project[]
  properties Property[]
  customers  Customer[]
  bookings   Booking[]
  siteVisits SiteVisit[]
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  SALES_EXECUTIVE
  CHANNEL_PARTNER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  email        String
  phone        String?
  passwordHash String
  role         UserRole   @default(SALES_EXECUTIVE)
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions             Session[]
  assignedLeads        Lead[]         @relation("AssignedLeads")
  createdLeads         Lead[]         @relation("CreatedLeads")
  leadActivities       LeadActivity[]
  assignedCustomers    Customer[]     @relation("AssignedCustomers")
  assignedBookings     Booking[]      @relation("AssignedBookings")
  assignedSiteVisits   SiteVisit[]    @relation("AssignedSiteVisits")

  @@unique([organizationId, email])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  QUALIFIED
  SITE_VISIT
  NEGOTIATION
  BOOKED
  CLOSED
  LOST
}

model Lead {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name  String
  phone String
  email String?

  source      String?
  campaign    String?
  landingPage String?

  status LeadStatus @default(NEW)

  assignedToId String?
  assignedTo   User?   @relation("AssignedLeads", fields: [assignedToId], references: [id])

  interestedUnitType String?

  preferredVisitDate DateTime? // Stored in UTC
  preferredVisitTime String?

  message        String?
  nextFollowUpAt DateTime? // Stored in UTC

  createdById String?
  createdBy   User?   @relation("CreatedLeads", fields: [createdById], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities LeadActivity[]
  siteVisits SiteVisit[]

  @@index([organizationId])
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  STATUS_CHANGE
  ASSIGNMENT
  FOLLOW_UP
  SITE_VISIT
}

model LeadActivity {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type        ActivityType
  description String

  performedById String?
  performedBy   User?   @relation(fields: [performedById], references: [id])

  metadata Json?

  createdAt DateTime @default(now())

  @@index([organizationId])
}

enum ProjectStatus {
  PRE_LAUNCH
  UNDER_CONSTRUCTION
  AVAILABLE
  FULLY_OCCUPIED
  RENOVATING
}

model Project {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name          String
  address       String
  city          String?
  type          String        // Residential, Commercial, Retail
  totalUnits    Int?
  occupiedUnits Int?
  status        ProjectStatus @default(AVAILABLE)
  price         Decimal?      @db.Decimal(12, 2) // Base monetary value
  description   String?
  amenities     String[]
  yearBuilt     String?
  floors        String?
  parkingSpots  String?
  images        String[]      // Array of photo URLs

  properties    Property[]
  leads         Lead[]
  bookings      Booking[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([organizationId])
}

enum PropertyStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model Property {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  title          String
  unitNumber     String?
  configuration  String?      // e.g. "3 BHK"
  bhk            Int?
  area           Int?         // sq.ft
  floor          Int?
  facing         String?
  price          Decimal      @db.Decimal(12, 2)
  status         PropertyStatus @default(AVAILABLE)
  version        Int          @default(0) // Optimistic locking
  featured       Boolean      @default(false)
  images         String[]     

  leads          Lead[]
  bookings       Booking[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, projectId])
}

enum CustomerStatus {
  ACTIVE
  CLOSED
  INACTIVE
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name           String
  phone          String
  email          String?
  status         CustomerStatus @default(ACTIVE)
  notes          String?

  assignedToId   String?
  assignedTo     User?        @relation("AssignedCustomers", fields: [assignedToId], references: [id])

  bookings       Booking[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

enum BookingPaymentStatus {
  PENDING
  PARTIAL
  COMPLETED
  CANCELLED
}

model Booking {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id])

  propertyId     String?
  property       Property?    @relation(fields: [propertyId], references: [id])

  amount         Decimal      @db.Decimal(12, 2)
  bookingDate    DateTime     @default(now()) // Stored in UTC
  paymentStatus  BookingPaymentStatus @default(PENDING)

  assignedToId   String?
  assignedTo     User?        @relation("AssignedBookings", fields: [assignedToId], references: [id])

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

enum SiteVisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model SiteVisit {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  
  // Snapshot/Fallback fields for historical records or unlinked visits
  leadName       String?
  phone          String?
  propertyName   String?
  
  date           DateTime     // Stored in UTC
  time           String       // Time string like "11:30 AM" or stored as part of date
  status         SiteVisitStatus @default(SCHEDULED)

  assignedToId   String?
  assignedTo     User?        @relation("AssignedSiteVisits", fields: [assignedToId], references: [id])

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}
