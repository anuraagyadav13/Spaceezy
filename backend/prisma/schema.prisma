generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrgStatus {
  ACTIVE
  INACTIVE
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users      User[]
  leads      Lead[]
  activities LeadActivity[]
  projects   Project[]
  configurations Configuration[]
  properties Property[]
  customers  Customer[]
  bookings   Booking[]
  siteVisits SiteVisit[]
  tasks      Task[]
  calls      Call[]
  quotations Quotation[]
  whatsappConversations WhatsAppConversation[]
  whatsappMessages      WhatsAppMessage[]
  whatsappTemplates     WhatsAppTemplate[]
  whatsappSettings      WhatsappSettings?
  whatsappNotifications WhatsappNotification[]
  notifications         Notification[]
  auditLogs   AuditLog[]
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  SALES_EXECUTIVE
  CHANNEL_PARTNER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  email        String
  phone        String?
  passwordHash String
  role         UserRole   @default(SALES_EXECUTIVE)
  status       UserStatus @default(ACTIVE)

  // Max active self-claimed leads for SALES_EXECUTIVE. Null = claiming not configured (0).
  selfClaimLimit Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions           Session[]
  assignedLeads      Lead[]         @relation("AssignedLeads")
  createdLeads       Lead[]         @relation("CreatedLeads")
  leadActivities     LeadActivity[]
  assignedCustomers  Customer[]     @relation("AssignedCustomers")
  assignedBookings   Booking[]      @relation("AssignedBookings")
  assignedSiteVisits SiteVisit[]    @relation("AssignedSiteVisits")
  assignedTasks      Task[]         @relation("AssignedTasks")
  calls              Call[]         @relation("UserCalls")
  createdQuotations  Quotation[]    @relation("CreatedQuotations")
  sentWhatsAppMessages WhatsAppMessage[]
  notifications      Notification[]

  @@unique([organizationId, email])
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  QUALIFIED
  SITE_VISIT
  NEGOTIATION
  BOOKED
  CLOSED
  LOST
  FOLLOW_UP
  QUOTATION
}

// Canonical location hierarchy (system-wide master; one source of truth shared by
// Lead requirements and Project/Property locations). IDs are used internally,
// names are display values.
model LocationState {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String   @unique
  createdAt DateTime @default(now())

  districts       LocationDistrict[]
  projects        Project[]
  leadPreferences LeadPreferredLocation[]

  @@index([name])
}

model LocationDistrict {
  id      String @id @default(uuid())
  stateId String
  state   LocationState @relation(fields: [stateId], references: [id], onDelete: Cascade)
  name    String

  createdAt DateTime @default(now())

  regions          LocationRegion[]
  projects         Project[]
  leadPreferences  LeadPreferredLocation[]

  @@unique([stateId, name])
  @@index([stateId])
}

model LocationRegion {
  id         String @id @default(uuid())
  districtId String
  district   LocationDistrict @relation(fields: [districtId], references: [id], onDelete: Cascade)
  name       String

  createdAt DateTime @default(now())

  projects         Project[]
  leadPreferences  LeadPreferredLocation[]

  @@unique([districtId, name])
  @@index([districtId])
}

// One row per preferred location on a lead. Each row is a hierarchical selection:
// state is always set; district/region optional (state-only or district-only
// preference matches everything inside it during property matching).
model LeadPreferredLocation {
  id     String @id @default(uuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  stateId    String
  state      LocationState @relation(fields: [stateId], references: [id], onDelete: Cascade)
  districtId String?
  district   LocationDistrict? @relation(fields: [districtId], references: [id], onDelete: Cascade)
  regionId   String?
  region     LocationRegion? @relation(fields: [regionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([stateId])
  @@index([districtId])
  @@index([regionId])
}

model Lead {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name  String
  phone String
  email String?

  source      String?
  campaign    String?
  landingPage String?

  status LeadStatus @default(NEW)

  budget Decimal? @db.Decimal(14, 2)

  // Customer requirement (distinct from the interested project/property refs below).
  // budgetMin/budgetMax are the authoritative numeric requirement; `budget` above is
  // kept in sync (= budgetMax ?? budgetMin) for legacy display/filters.
  budgetMin Decimal? @db.Decimal(14, 2)
  budgetMax Decimal? @db.Decimal(14, 2)
  propertyType String? // 'Residential' | 'Commercial'
  configurations String[] @default([]) // canonical configuration labels, e.g. ["2 BHK", "3 BHK"]

  assignedToId String?
  assignedTo   User?   @relation("AssignedLeads", fields: [assignedToId], references: [id])

  interestedUnitType String?

  // Free-text enquiry context captured from the public site.
  // `enquiryLocation` is the area the visitor wants to buy in — deliberately a
  // plain string, not part of the structured `preferredLocations` relation
  // below, because visitors type arbitrary text that can't be resolved to a
  // state/district/region. `requestedProjectName` records a project they named
  // by hand when theirs isn't in the dropdown; projectId stays NULL there, so
  // the two must never be conflated.
  enquiryLocation      String?
  requestedProjectName String?

  preferredVisitDate DateTime? // Stored in UTC
  preferredVisitTime String?

  message        String?
  nextFollowUpAt DateTime? // Stored in UTC

  createdById String?
  createdBy   User?   @relation("CreatedLeads", fields: [createdById], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  // Bulk-mode attribution: which project configuration the enquiry is about.
  // Nullable + SetNull so configuration lifecycle never destroys leads.
  configurationId String?
  configuration   Configuration? @relation(fields: [configurationId], references: [id], onDelete: SetNull)

  // Meta Lead Ads attribution. All nullable: NULL = non-Meta lead.
  // metaLeadId is the Meta-assigned lead identifier, unique per org for
  // webhook idempotency. metaPlatform is only set when reliably determinable
  // ('Facebook' | 'Instagram') — never inferred.
  metaLeadId       String?
  metaPageId       String?
  metaFormId       String?
  metaAdId         String?
  metaAdsetId      String?
  metaCampaignId   String?
  metaCampaignName String?
  metaPlatform     String?
  metaCreatedAt    DateTime? // submission time reported by Meta (UTC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities LeadActivity[]
  siteVisits SiteVisit[]
  tasks      Task[]
  calls      Call[]
  quotations Quotation[]
  interests  LeadInterest[]
  bookings   Booking[]
  preferredLocations LeadPreferredLocation[]
  whatsappConversations WhatsAppConversation[]
  whatsappMessages      WhatsAppMessage[]
  whatsappNotifications WhatsappNotification[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, assignedToId])
  @@index([organizationId, projectId])
  @@index([organizationId, configurationId])
  @@unique([organizationId, metaLeadId])
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  STATUS_CHANGE
  ASSIGNMENT
  FOLLOW_UP
  SITE_VISIT
  WHATSAPP
  TASK
  QUOTATION
  BOOKING
}

model LeadActivity {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type        ActivityType
  description String

  performedById String?
  performedBy   User?   @relation(fields: [performedById], references: [id])

  metadata Json?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([leadId, createdAt])
}

enum ProjectStatus {
  UPCOMING
  PRE_LAUNCH
  UNDER_CONSTRUCTION
  READY_TO_MOVE
  AVAILABLE
  COMPLETED
  FULLY_OCCUPIED
  RENOVATING
  ON_HOLD
  SOLD_OUT
  INACTIVE
}

model Project {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name             String
  projectType      String        @default("Residential") // Residential, Commercial, Mixed_Use
  status           ProjectStatus @default(AVAILABLE)
  developer        String?
  description      String?
  shortDescription String?

  // Public website (unauthenticated). publicSlug is URL-safe
  // (name-slug + short random suffix, unique). isPublic publishes the project
  // and its units to the public APIs/pages (default: draft / not published).
  publicSlug String? @unique
  isPublic   Boolean @default(false)

  // Location
  // Canonical hierarchy FKs (authoritative for property matching). The legacy
  // free-text columns below stay for display/backward compatibility and are
  // denormalized from the canonical names when the FKs are written.
  stateId     String?
  locationState   LocationState?   @relation(fields: [stateId], references: [id])
  districtId  String?
  locationDistrict LocationDistrict? @relation(fields: [districtId], references: [id])
  regionId    String?
  locationRegion   LocationRegion?   @relation(fields: [regionId], references: [id])

  address   String
  locality  String?
  city      String?
  state     String?
  pincode   String?
  latitude  Float?
  longitude Float?
  mapUrl    String?
  landmark  String?

  // Overview
  totalLandArea          Float?
  landAreaUnit           String?
  totalTowers            Int?
  totalFloors            Int?
  totalUnits             Int?
  availableUnits         Int?
  launchDate             DateTime?
  expectedCompletionDate DateTime?
  possessionDate         DateTime?

  // RERA
  reraRegistered Boolean @default(false)
  reraNumber     String?
  reraAuthority  String?

  // Pricing
  startingPrice      Decimal? @db.Decimal(12, 2)
  maximumPrice       Decimal? @db.Decimal(12, 2)
  pricePerSqFt       Decimal? @db.Decimal(12, 2)
  priceUnit          String?
  maintenanceCharges Decimal? @db.Decimal(12, 2)
  plcCharges         Decimal? @db.Decimal(12, 2)
  parkingCharges     Decimal? @db.Decimal(12, 2)
  clubCharges        Decimal? @db.Decimal(12, 2)
  otherCharges       Decimal? @db.Decimal(12, 2)

  // Amenities & Assets
  amenities    String[]
  images       String[]
  documents    Json? // e.g. [{name: "Brochure", url: "..."}]
  connectivity Json? // e.g. [{name: "Airport", category: "Transport", distance: "5km", time: "10m"}]

  properties     Property[]
  configurations Configuration[]
  leads          Lead[]
  bookings       Booking[]
  quotations     Quotation[]
  siteVisits     SiteVisit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// Project -> Configuration -> Property/Unit
model Configuration {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String   // e.g. "2 BHK", "Retail Shop"
  bhk         Int?
  areaSaleable Int? // sq.ft
  basePrice   Decimal? @db.Decimal(12, 2)
  active      Boolean  @default(true)

  // Bulk inventory mode (Phase 1: aggregate counts without individual unit
  // rows). NULL counters = classic unit-tracked mode (counts derive from
  // linked Property rows). Both counters set = bulk mode; a bulk-mode
  // configuration must have zero linked properties (enforced in service).
  totalUnits     Int?
  availableUnits Int?
  // Optimistic concurrency for explicit inventory adjustments — bumped only
  // by the dedicated inventory endpoint, never by unrelated edits.
  inventoryVersion Int @default(0)
  // Representative ranges shown publicly; areaSaleable/basePrice above stay
  // the single values inherited by individually-tracked units.
  areaMin  Int?
  areaMax  Int?
  priceMin Decimal? @db.Decimal(12, 2)
  priceMax Decimal? @db.Decimal(12, 2)

  properties Property[]
  leads      Lead[]
  bookings   Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([organizationId, projectId])
}

enum PropertyStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model Property {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  configurationId String?
  config          Configuration? @relation(fields: [configurationId], references: [id], onDelete: SetNull)

  title         String
  purpose       String? // Sale, Resale, Rent
  type          String? // Residential, Commercial, Plot
  tower         String? // Tower/block
  unitNumber    String?
  configuration String? // e.g. "3 BHK"
  bhk           Int?
  area          Int? // Legacy/fallback sq.ft
  areaCarpet    Int? // sq.ft
  areaSaleable  Int? // sq.ft
  areaBuiltUp   Int? // sq.ft
  areaProject   Int? // sq.ft
  areaCovered   Int? // sq.ft
  areaTerrace   Int? // sq.ft
  floor         Int?
  facing        String?
  price         Decimal        @db.Decimal(12, 2)
  status        PropertyStatus @default(AVAILABLE)
  version       Int            @default(0) // Optimistic locking
  featured      Boolean        @default(false)
  images        String[]
  amenities     String[]

  // Public share (unauthenticated public website + WhatsApp sharing).
  // publicToken is an opaque 32-hex token — internal unit IDs never appear in
  // public URLs. isPublic gates the public page (default: not published).
  publicToken String? @unique
  isPublic    Boolean @default(false)

  leads        Lead[]
  bookings     Booking[]
  interestedBy LeadInterest[]
  quotations   Quotation[]
  siteVisits   SiteVisit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, unitNumber])
  @@index([organizationId, projectId])
}

enum CustomerStatus {
  ACTIVE
  CLOSED
  INACTIVE
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name   String
  phone  String
  email  String?
  status CustomerStatus @default(ACTIVE)
  notes  String?

  assignedToId String?
  assignedTo   User?   @relation("AssignedCustomers", fields: [assignedToId], references: [id])

  bookings Booking[]
  calls    Call[]
  whatsappConversations WhatsAppConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

enum BookingPaymentStatus {
  PENDING
  PARTIAL
  COMPLETED
  CANCELLED
}

model Booking {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  // Bulk-mode booking target (Phase 2). Exactly one of propertyId /
  // configurationId is set (enforced in service + validators); bulk bookings
  // atomically decrement the configuration's availableUnits.
  configurationId String?
  configuration   Configuration? @relation(fields: [configurationId], references: [id], onDelete: SetNull)

  amount        Decimal              @db.Decimal(12, 2)
  bookingDate   DateTime             @default(now()) // Stored in UTC
  paymentStatus BookingPaymentStatus @default(PENDING)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  quotationId String?   @unique
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation("AssignedBookings", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([leadId])
  @@index([organizationId, configurationId])
}

enum SiteVisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model SiteVisit {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // Snapshot/Fallback fields for historical records or unlinked visits
  leadName     String?
  phone        String?
  propertyName String?

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  date   DateTime // Stored in UTC
  time   String // Time string like "11:30 AM" or stored as part of date
  status SiteVisitStatus @default(SCHEDULED)

  assignedToId String?
  assignedTo   User?   @relation("AssignedSiteVisits", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, status, date])
  @@index([projectId])
  @@index([propertyId])
}

enum TaskType {
  FOLLOW_UP
  MEETING
  CALL
  SITE_VISIT
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Task {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title       String
  description String?
  type        TaskType   @default(FOLLOW_UP)
  status      TaskStatus @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime // Stored in UTC
  completedAt DateTime?
  rescheduledAt     DateTime?
  rescheduleReason  String?
  sourceCallId String?
  sourceCall   Call?   @relation(fields: [sourceCallId], references: [id], onDelete: SetNull)
  createdById  String?

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  assignedToId String
  assignedTo   User   @relation("AssignedTasks", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, status, dueDate])
  @@index([leadId])
  @@index([organizationId, assignedToId, status, dueDate])
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  INITIATED
  RINGING
  IN_PROGRESS
  COMPLETED
  MISSED
  FAILED
}

enum CallOutcome {
  INTERESTED
  NOT_INTERESTED
  CALL_BACK
  FOLLOW_UP_REQUIRED
  NO_ANSWER
  BUSY
  WRONG_NUMBER
  SITE_VISIT_INTERESTED
  QUOTATION_INTERESTED
  OTHER
}

model Call {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  direction CallDirection
  status    CallStatus    @default(INITIATED)

  fromNumber String
  toNumber   String

  provider   String  @default("none")
  disposition CallOutcome?
  notes      String?
  startedAt  DateTime?
  endedAt    DateTime?

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation("UserCalls", fields: [userId], references: [id], onDelete: SetNull)

  duration     Int? // in seconds
  recordingUrl String?

  vendorCallId String? // ID from the telephony provider

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events CallEvent[]
  tasks  Task[]

  @@index([organizationId])
  @@index([vendorCallId])
  @@index([organizationId, leadId, createdAt])
  @@index([organizationId, userId, createdAt])
}

model CallEvent {
  id     String @id @default(uuid())
  callId String
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  status    CallStatus
  timestamp DateTime   @default(now())

  metadata Json?
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quotation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  totalAmount Decimal         @db.Decimal(12, 2)
  validUntil  DateTime
  status      QuotationStatus @default(DRAFT)

  notes String?

  createdById String
  createdBy   User   @relation("CreatedQuotations", fields: [createdById], references: [id])

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([leadId, status])
  @@index([organizationId, createdAt])
}

model LeadInterest {
  id     String @id @default(uuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([leadId, propertyId])
}


enum WhatsAppDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsAppConversation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  provider          String  @default("none")
  providerContactId String?
  status            String  @default("ACTIVE") // ACTIVE | CLOSED
  lastMessageAt     DateTime?
  unreadCount       Int     @default(0)

  messages WhatsAppMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, provider, providerContactId])
  @@index([organizationId, lastMessageAt])
  @@index([organizationId, leadId])
}

model WhatsAppMessage {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  direction WhatsAppDirection
  status    WhatsAppMessageStatus @default(QUEUED)

  body     String
  templateName String?
  variables    Json?

  providerMessageId String?

  // Companion document metadata (generated brochure PDF delivered alongside
  // the message). Columns added by migration
  // 20261021130000_whatsapp_message_attachment.
  attachmentUrl   String?
  attachmentName String?

  sentById String?
  sentBy   User?   @relation(fields: [sentById], references: [id], onDelete: SetNull)

  error String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, providerMessageId])
  @@index([organizationId, createdAt])
  @@index([conversationId, createdAt])
  @@index([leadId, createdAt])
}

model WhatsAppTemplate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name              String
  providerTemplateId String?
  language          String  @default("en")
  category          String  @default("UTILITY") // MARKETING | UTILITY | AUTHENTICATION
  // Human-readable short description for the template selector.
  description       String?
  // Message preview text with {{named}} placeholders. Custom templates may
  // leave this empty (selector then shows name + variables only).
  body              String?
  variables         Json?   // array of variable names, e.g. ["lead_name", "project_name"]
  active            Boolean @default(true)

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

// Meta WhatsApp integration settings — at most one row per organization.
// Secrets are AES-256-GCM envelopes (never plaintext); see
// src/utils/whatsappSecrets.js. Non-secret fields are stored plainly.
//
// Effective-configuration rule: row absent → legacy environment behavior;
// row present → the row is authoritative (env is NOT consulted afterwards,
// and a decryption failure fails closed instead of falling back).
model WhatsappSettings {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  appId         String?
  wabaId        String?
  phoneNumberId String?      @unique
  graphVersion  String        @default("v21.0")
  providerMode  String        @default("mock") // mock | meta (explicit admin action only)

  accessTokenEnc   String?
  appSecretEnc     String?
  verifyTokenEnc   String?

  // New-lead WhatsApp notifications (admin-configured, off by default).
  notifyEnabled      Boolean @default(false)
  notifyRecipients   Json?   // [{ phone, label, enabled }] — phones in E.164, validated server-side
  notifyTemplateName String? // DB template name; approval verified live via Meta before each send

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// Outbox record for exactly-once new-lead WhatsApp notifications.
// Unique (organizationId, leadId, recipient) makes retries, webhook
// redeliveries and concurrent processing idempotent by construction.
model WhatsappNotification {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  recipient    String // configured E.164 recipient number (never lead-supplied)
  templateName String?

  status          String  @default("PENDING") // PENDING | SENT | DELIVERED | READ | FAILED
  attempts        Int     @default(0)
  error           String?
  providerMessageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, leadId, recipient])
  @@index([organizationId, status])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  actorId   String?
  action    String // e.g. call.initiated, pii.viewed, recording.accessed, whatsapp.sent
  entityType String?
  entityId   String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
}

// In-app notification (e.g. "a lead was assigned to you"). Scoped to the
// recipient user; only the recipient ever reads/marks their own rows.
model Notification {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String // e.g. LEAD_ASSIGNED
  title   String
  body    String?
  leadId  String? // optional link target (no FK — a deleted lead must not destroy notifications)
  link    String? // client-side route to open on click
  read    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
  @@index([organizationId, userId])
}
