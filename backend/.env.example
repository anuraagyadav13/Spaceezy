# Runtime
NODE_ENV=development
PORT=8000

# Origin of this API when called server-to-server (webhook callback URLs).
BACKEND_URL=http://localhost:8000

# PostgreSQL connection strings
# Use a pooled connection for runtime querying if available
DATABASE_URL=postgresql://user:password@localhost:5432/spaceezy?schema=public

# Use a direct, non-pooled connection for Prisma migrations (npx prisma migrate deploy)
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/spaceezy?schema=public

# Production RDS example (never commit real credentials):
# DATABASE_URL=postgresql://USER:PASSWORD@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/spaceezy?schema=public&sslmode=require

# Public origin of the Next.js app (CORS allow-list + public share/OG links).
# Production: https://spaceezy.com
FRONTEND_URL=http://localhost:3000

# Optional comma-separated CORS allow-list (overrides FRONTEND_URL when set).
# Use when both apex and www must be allowed:
# CORS_ORIGINS=https://spaceezy.com,https://www.spaceezy.com

# Reverse-proxy trust (default 'loopback' — correct behind local Nginx).
# Set to 'false' when the API is exposed directly with no proxy.
# TRUST_PROXY=loopback

# Session (opaque DB-backed token stored in an HttpOnly cookie)
SESSION_COOKIE_NAME=spaceezy_session
SESSION_TTL_DAYS=7

# Redis — reserved for future use; no application code connects today.
# REDIS_URL=redis://:change-me@localhost:6379/0

# WhatsApp provider: none | mock (simulated) | generic (real HTTP gateway) | meta (official Cloud API)
WHATSAPP_PROVIDER=mock
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_WEBHOOK_SECRET=change-me
# Meta Cloud API (WHATSAPP_PROVIDER=meta only; leave empty otherwise)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=
# Database-persisted settings encryption (AES-256-GCM, 32-byte key as 64 hex).
# Generate: openssl rand -hex 32
# Required once integration settings are saved via the CRM; without it,
# saving secrets fails closed. Lives in the server env file only — never git.
WHATSAPP_SETTINGS_KEY=

# Meta Marketing API (SpaceEzy's own ad assets; read-only reporting).
#
# DEPLOYMENT-ONLY (stay in the server env file):
# - META_ADS_SETTINGS_KEY: the AES-256-GCM key that encrypts Meta secrets at
#   rest. It must never be reachable from the frontend or the database, so it
#   cannot be moved into CRM settings.
# - META_AD_ACCOUNT_ID / META_PAGE_ID: legacy defaults used only until the
#   first settings row is saved; after that the CRM selection is authoritative.
# - META_GRAPH_VERSION: deployment default; overridable per row in the CRM.
# - META_RATE_LIMIT_*: operational tuning (see below).
#
# LEGACY FALLBACK ONLY (no settings row exists yet): Meta App ID, App Secret,
# Access Token and Webhook Verify Token are all manageable in the CRM at
# Marketing → Meta Connection → Settings (stored encrypted). Keep these env
# values only for backward compatibility with an env-configured deployment;
# once a settings row exists the row is authoritative and env is ignored.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_GRAPH_VERSION=
# Meta Lead Ads webhook (subscribe the leadgen field in App Dashboard →
# Webhooks, pointing at <BACKEND_URL>/api/v1/webhooks/meta/leadgen).
# The verify token itself is set in CRM settings (Section B); this env value
# is the legacy fallback used only when no settings row exists.
META_WEBHOOK_VERIFY_TOKEN=

# Facebook Login for Business configuration id (optional). When set, the
# Meta Ads authorize URL sends config_id + override_default_response_type
# instead of scope — permissions come from the configuration saved in the
# Meta app dashboard (token type: System User; select the ad accounts,
# Pages and Instagram accounts as its assets there). Blank = legacy
# scope-based flow. Not a secret (it appears in the authorize URL), but it
# lives in the server env only — never in the frontend bundle.
META_OAUTH_CONFIG_ID=

# Meta Ads settings encryption (AES-256-GCM, 32-byte key as 64 hex).
# Separate key from WHATSAPP_SETTINGS_KEY — each integration has its own.
# Generate: openssl rand -hex 32
# Required once Meta connection settings are saved via the CRM (also signs
# the OAuth state); without it, saving/connecting fails closed. Lives in the
# server env file only — never git, never printed in logs or reports, never
# editable or readable from the frontend.
META_ADS_SETTINGS_KEY=

# Meta-facing rate limits (requests per 15 minutes, per IP). Defaults are
# deliberately generous so legitimate dashboard traffic and Meta's bursty
# webhook deliveries are never shaped; tune only if you need to tighten.
# META_RATE_LIMIT_READ_MAX=600
# META_RATE_LIMIT_WEBHOOK_MAX=600
# META_RATE_LIMIT_CONNECT_MAX=120

# Telephony provider: none | mock | generic
TELEPHONY_PROVIDER=mock
TELEPHONY_API_URL=
TELEPHONY_API_KEY=
TELEPHONY_BUSINESS_NUMBER=
TELEPHONY_WEBHOOK_SECRET=change-me

# S3 media storage (image uploads for projects/properties).
# Leave AWS_S3_BUCKET empty to disable uploads (development fallback).
# Credentials come from the AWS default provider chain — EC2 IAM role in
# production, AWS_* environment variables or ~/.aws locally. Never commit keys.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_S3_PREFIX=uploads
# Optional custom public base URL in front of the bucket (CDN/domain):
# AWS_S3_PUBLIC_BASE_URL=https://media.spaceezy.com

# --- Amazon SES transactional email (password-reset codes) -------------------
# Also read by the same AWS default provider chain as above: EC2 IAM role in
# production, AWS_* env vars or ~/.aws locally. NEVER put access keys here.
# Region must be the one the sender identity is verified in (AWS_REGION above).
#
# Leave SES_FROM_EMAIL empty to disable outbound email: forgot-password then
# still answers generically but delivers nothing (and logs EMAIL_NOT_CONFIGURED).
SES_FROM_EMAIL=no-reply@spaceezy.com
SES_FROM_NAME=SpaceEzy
# Optional SES configuration set (bounce/complaint tracking in the console):
SES_CONFIGURATION_SET=

# Password-reset rate limits (requests per 15 minutes; unset = default shown).
# RESET_RATE_LIMIT_IP_MAX=10
# RESET_RATE_LIMIT_ACCOUNT_MAX=5
# RESET_RATE_LIMIT_VERIFY_IP_MAX=20
# RESET_RATE_LIMIT_RESET_IP_MAX=10
