# Runtime
NODE_ENV=development
PORT=8000

# Origin of this API when called server-to-server (webhook callback URLs).
BACKEND_URL=http://localhost:8000

# PostgreSQL connection strings
# Use a pooled connection for runtime querying if available
DATABASE_URL=postgresql://user:password@localhost:5432/spaceezy?schema=public

# Use a direct, non-pooled connection for Prisma migrations (npx prisma migrate deploy)
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/spaceezy?schema=public

# Production RDS example (never commit real credentials):
# DATABASE_URL=postgresql://USER:PASSWORD@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/spaceezy?schema=public&sslmode=require

# Public origin of the Next.js app (CORS allow-list + public share/OG links).
# Production: https://spaceezy.com
FRONTEND_URL=http://localhost:3000

# Optional comma-separated CORS allow-list (overrides FRONTEND_URL when set).
# Use when both apex and www must be allowed:
# CORS_ORIGINS=https://spaceezy.com,https://www.spaceezy.com

# Reverse-proxy trust (default 'loopback' — correct behind local Nginx).
# Set to 'false' when the API is exposed directly with no proxy.
# TRUST_PROXY=loopback

# Session (opaque DB-backed token stored in an HttpOnly cookie)
SESSION_COOKIE_NAME=spaceezy_session
SESSION_TTL_DAYS=7

# Redis — reserved for future use; no application code connects today.
# REDIS_URL=redis://:change-me@localhost:6379/0

# WhatsApp provider: none | mock (simulated) | generic (real HTTP gateway) | meta (official Cloud API)
WHATSAPP_PROVIDER=mock
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_WEBHOOK_SECRET=change-me
# Meta Cloud API (WHATSAPP_PROVIDER=meta only; leave empty otherwise)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=
# Database-persisted settings encryption (AES-256-GCM, 32-byte key as 64 hex).
# Generate: openssl rand -hex 32
# Required once integration settings are saved via the CRM; without it,
# saving secrets fails closed. Lives in the server env file only — never git.
WHATSAPP_SETTINGS_KEY=

# Meta Marketing API (SpaceEzy's own ad assets; read-only reporting).
# System-user token + IDs live in backend/.env only — never commit values.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_GRAPH_VERSION=
# Meta Lead Ads webhook (subscribe the leadgen field in App Dashboard →
# Webhooks, pointing at <BACKEND_URL>/api/v1/webhooks/meta/leadgen).
# Generate: openssl rand -hex 32
META_WEBHOOK_VERIFY_TOKEN=

# Telephony provider: none | mock | generic
TELEPHONY_PROVIDER=mock
TELEPHONY_API_URL=
TELEPHONY_API_KEY=
TELEPHONY_BUSINESS_NUMBER=
TELEPHONY_WEBHOOK_SECRET=change-me

# S3 media storage (image uploads for projects/properties).
# Leave AWS_S3_BUCKET empty to disable uploads (development fallback).
# Credentials come from the AWS default provider chain — EC2 IAM role in
# production, AWS_* environment variables or ~/.aws locally. Never commit keys.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_S3_PREFIX=uploads
# Optional custom public base URL in front of the bucket (CDN/domain):
# AWS_S3_PUBLIC_BASE_URL=https://media.spaceezy.com
